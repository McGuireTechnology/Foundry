# Project
NAME=vortex
DOMAIN=vortex.mcguire.technology

## Docker Compose
COMPOSE_PROJECT_NAME=vortex
COMPOSE_PROFILES=prometheus,grafana,postgres-exporter,loki,promtail,minio,tempo,otel-collector,alertmanager,flower

# Core Data and Queue Plane

## Postgres
POSTGRES_DB=vortex
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

## PgBouncer
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_INTERNAL_PORT=5432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_PORT=6432

## Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Application Runtime

# Workflow and Scheduling Plane

## Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=

# Analytics and BI Plane

## Superset
SUPERSET_SECRET_KEY=thisISaSECRET_ChangeMe
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# Edge and Routing

## Traefik / TLS
TRAEFIK_DOMAIN=example.com
TRAEFIK_EMAIL=admin@example.com
TRAEFIK_VERSION=3.6

# Admin Plane

## pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_VERSION=9

# Data Transformation Plane

## dbt
DBT_POSTGRES_VERSION=1.8.2

# Observability Plane

## Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_VERSION=11.2.3

## Prometheus
PROMETHEUS_VERSION=v2.55.1

## Postgres Exporter
POSTGRES_EXPORTER_VERSION=v0.16.0

## Loki
LOKI_VERSION=3.2.1

## Promtail
PROMTAIL_VERSION=3.2.1

## Alertmanager
ALERTMANAGER_VERSION=v0.28.1
