{
  "name": "foundry",
  "private": true,
  "version": "0.1.1",
  "description": "Foundry low-code app platform monorepo",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "postinstall": "pnpm --filter @foundry/api bootstrap",
    "dev:local": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @foundry/web dev",
    "dev:docs": "pnpm --filter @foundry/docs dev",
    "dev:api": "pnpm --filter @foundry/api dev",
    "docker:up": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-watch.ps1",
    "docker:watch": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-watch.ps1",
    "docker:up:nowatch": "powershell -ExecutionPolicy Bypass -File ./scripts/docker-watch.ps1 -NoWatch",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres"
  }
}

